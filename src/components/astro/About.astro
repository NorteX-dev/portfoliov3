---
import { Image } from "astro:assets";
import typescriptImage from "@/assets/typescript.png";
import javascriptImage from "@/assets/javascript.png";
import nodeImage from "@/assets/node.png";
import astroImage from "@/assets/astro.svg";
import csharpImage from "@/assets/csharp.png";
import javaImage from "@/assets/java.png";
import reactImage from "@/assets/react.svg";
import luaImage from "@/assets/lua.png";
import tanstackQueryImage from "@/assets/tanstackquery.png";
import svelteImage from "@/assets/svelte.png";
import nextjsImage from "@/assets/nextjs.png";
import tailwindImage from "@/assets/tailwind.png";
import htmlImage from "@/assets/html.png";
import cssImage from "@/assets/css.svg";
import linuxImage from "@/assets/linux.png";
import { getTranslations } from "@/i18n/translations";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const t = getTranslations(Astro.currentLocale);

const skillGroups = [
	{
		title: t.about.groups.frontend,
		skills: [
			{ name: "React", image: reactImage },
			{ name: "Next.js", image: nextjsImage },
			{ name: "Svelte", image: svelteImage },
			{ name: "Astro", image: astroImage },
			{ name: "Tailwind", image: tailwindImage },
			{ name: "TanStack Query", image: tanstackQueryImage },
		],
	},
	{
		title: t.about.groups.languages,
		skills: [
			{ name: "TypeScript", image: typescriptImage },
			{ name: "JavaScript", image: javascriptImage },
			{ name: "C#", image: csharpImage },
			{ name: "Java", image: javaImage },
			{ name: "Lua", image: luaImage },
			{ name: "HTML", image: htmlImage },
			{ name: "CSS", image: cssImage },
		],
	},
	{
		title: t.about.groups.backend,
		skills: [
			{ name: "Node.js", image: nodeImage },
			{ name: t.about.linuxAdministration, image: linuxImage },
		],
	},
];
---

<a id="about"></a>
<section class={`py-[120px] max-md:py-20 ${className ?? ""}`}>
	<div class="mx-auto grid max-w-[1120px] items-start gap-16 px-6 md:grid-cols-2">
		<div>
			<div class="text-[13px] font-semibold tracking-[0.14em] text-[#1d4ed8] uppercase">{t.about.eyebrow}</div>
			<h2
				class="display-font mt-3 text-[clamp(36px,4.5vw,56px)] leading-[1.05] font-bold tracking-[-0.03em] text-[#0f0f10]"
			>
				{t.about.title}
			</h2>
			<div class="inter text-lg leading-[1.7] text-zinc-700">
				<p class="mt-6">
					{t.about.introBefore}<em class="font-semibold text-[#0f0f10] not-italic">{t.about.introEmphasis}</em
					>{t.about.introAfter}
				</p>
				<p class="mt-6">{t.about.body}</p>
			</div>
		</div>

		<div class="flex flex-col gap-4">
			{
				skillGroups.map(({ title, skills }) => (
					<div class="rounded-[20px] border border-zinc-200 bg-white p-6">
						<h3 class="display-font text-[15px] font-medium text-zinc-500">{title}</h3>
						<ul class="mt-3.5 flex flex-wrap gap-2">
							{skills.map(({ name, image }) => (
								<li class="inter inline-flex items-center gap-2 rounded-[10px] bg-zinc-100 py-[7px] pr-3 pl-2 text-sm font-medium text-[#0f0f10]">
									<Image
										src={image}
										alt=""
										width={40}
										height={40}
										class="size-5 rounded object-contain"
									/>
									{name}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
