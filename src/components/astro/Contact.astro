---
import { getTranslations } from "@/i18n/translations";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const t = getTranslations(Astro.currentLocale);

const lineButton =
	"inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-px";
---

<a id="contact"></a>
<section class={`inter py-[120px] max-md:py-20 ${className ?? ""}`}>
	<div class="mx-auto max-w-[1120px] px-6">
		<div
			class="contact-band relative grid items-end gap-10 overflow-hidden rounded-[28px] bg-[#111113] px-6 py-12 text-white md:grid-cols-[1.4fr_1fr] md:px-12 md:py-16"
		>
			<h2
				class="display-font relative z-10 text-[clamp(40px,5.5vw,68px)] leading-[0.95] font-bold tracking-[-0.045em]"
			>
				{t.contact.titleLines[0]}<br />{t.contact.titleLines[1]}
			</h2>
			<div class="relative z-10 flex flex-col gap-2.5">
				<p class="mb-2 text-zinc-400">{t.contact.description}</p>
				<button
					type="button"
					class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[#111113] transition hover:-translate-y-px"
					data-ctc="@nortex"
				>
					{t.contact.copyDiscord}
				</button>
				<a class={lineButton} href="mailto:contact@nortexdev.com">contact@nortexdev.com</a>
				<a class={lineButton} href="https://lightservices.nortexdev.com" target="_blank" rel="noreferrer">
					{t.contact.joinLightServices} &nearr;
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-band::after {
		content: "";
		position: absolute;
		top: -150px;
		right: -150px;
		width: 340px;
		height: 340px;
		background: #2f6bff;
		opacity: 0.7;
		mask-image: radial-gradient(circle, #000 15%, transparent 65%);
		clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
		animation: contact-star-spin 40s linear infinite;
		pointer-events: none;
	}

	@media (max-width: 767px) {
		.contact-band::after {
			top: -110px;
			right: -110px;
			width: 220px;
			height: 220px;
		}
	}

	@keyframes contact-star-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-band::after {
			animation: none;
		}
	}
</style>
