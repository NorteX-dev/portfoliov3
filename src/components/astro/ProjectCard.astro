---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
	title: string;
	description: string;
	image: ImageMetadata;
	tags: string[];
	href?: string;
	wide?: boolean;
}

const { title, description, image, tags, href, wide = false } = Astro.props;
const Tag = href ? "a" : "div";
const linkProps = href ? { href, target: "_blank", rel: "noreferrer" } : {};
---

<Tag
	class:list={[
		"group relative flex flex-col overflow-hidden rounded-[20px] border border-white/8 bg-[#18181b] transition duration-250 hover:-translate-y-1 hover:border-indigo-300/50",
		wide ? "md:col-span-3" : "md:col-span-2",
	]}
	{...linkProps}
>
	<div class:list={["overflow-hidden bg-zinc-800", wide ? "aspect-[16/8]" : "aspect-video"]}>
		<Image
			src={image}
			alt={title}
			width={wide ? 960 : 640}
			class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
		/>
	</div>
	<div class="flex flex-1 flex-col gap-2 p-[22px]">
		<h3 class="display-font flex justify-between gap-3 text-[22px] font-semibold">
			{title}
			{
				href && (
					<span class="font-normal text-zinc-400 transition group-hover:translate-x-1 group-hover:text-indigo-300">
						&rarr;
					</span>
				)
			}
		</h3>
		<p class="text-sm leading-[1.55] text-zinc-400">{description}</p>
		<div class="mt-auto flex flex-wrap gap-1.5 pt-2.5">
			{
				tags.map((tag) => (
					<span class="rounded-full border border-white/8 px-2.5 py-1 text-xs text-zinc-300">{tag}</span>
				))
			}
		</div>
	</div>
</Tag>
