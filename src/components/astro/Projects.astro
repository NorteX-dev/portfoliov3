---
import ProjectCard, { type Props as Project } from "./ProjectCard.astro";

import akatzukiCoverImage from "@/assets/projects/akatzuki.png";
import katocraftCoverImage from "@/assets/projects/katocraft.png";
import lsbotCoverImage from "@/assets/projects/lsbot.png";
import realmsCoverImage from "@/assets/projects/realms.png";
import productsCoverImage from "@/assets/projects/products.png";
import kangv3CoverImage from "@/assets/projects/kangaroov3.png";
import nhandlerCoverImage from "@/assets/projects/nhandler.png";
import nconfigCoverImage from "@/assets/projects/nconfig.png";
import omegalicensingCoverImage from "@/assets/projects/omegalicensing.png";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const featuredProjects: Project[] = [
	{
		title: "Realms Hosting",
		description: "Landing page for realms.host along with a WordPress-based blog system.",
		image: realmsCoverImage,
		tags: ["Website", "WordPress"],
		href: "https://realmv2.vercel.app/",
		wide: true,
	},
	{
		title: "Light Services Bot",
		description: "Ticketing and payment handling Discord bot sold on BuiltByBit.",
		image: lsbotCoverImage,
		tags: ["Discord bot", "Payments"],
		href: "https://builtbybit.com/resources/ticket-bot-paypal-crypto-invoices.22995/",
		wide: true,
	},
	{
		title: "OmegaLicensing",
		description: "License management bot sold on BuiltByBit.",
		image: omegalicensingCoverImage,
		tags: ["Discord bot"],
		href: "https://builtbybit.com/resources/omegalicensing-system.41222/",
	},
	{
		title: "NConfig",
		description: "A standardized way to write type-safe, validated configs.",
		image: nconfigCoverImage,
		tags: ["Open source", "TypeScript"],
		href: "https://github.com/nortex-dev/nconfig",
	},
	{
		title: "Light Products",
		description: "Resource market for your members, or sell your own.",
		image: productsCoverImage,
		tags: ["Discord bot"],
		href: "https://builtbybit.com/resources/light-products-sell-products.51932/",
	},
];

const moreProjects: Project[] = [
	{
		title: "NHandler",
		description: "Discord bot command and event handling utility.",
		image: nhandlerCoverImage,
		tags: ["Open source"],
		href: "https://github.com/nortex-dev/nhandler",
		wide: true,
	},
	{
		title: "Kangaroo v3",
		description: "Helped with the hero and code clean-up.",
		image: kangv3CoverImage,
		tags: ["Website"],
		wide: true,
	},
	{
		title: "Akatzuki",
		description: "Client order, NFT project website.",
		image: akatzukiCoverImage,
		tags: ["Client", "Preview unavailable"],
		wide: true,
	},
	{
		title: "Katocraft",
		description: "Client order, CS:GO Katowice 2014 sticker search.",
		image: katocraftCoverImage,
		tags: ["Client", "Preview unavailable"],
		wide: true,
	},
];
---

<a id="projects"></a>
<section
	class={`projects inter relative overflow-hidden bg-[#0f0f10] py-[120px] text-white max-md:py-20 ${className ?? ""}`}
>
	<div class="relative mx-auto max-w-[1120px] px-6">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<div>
				<div class="text-[13px] font-semibold tracking-[0.14em] text-indigo-300 uppercase">Selected work</div>
				<h2 class="display-font mt-3 text-[clamp(36px,4.5vw,56px)] leading-[1.05] font-bold tracking-[-0.03em]">
					My Projects
				</h2>
			</div>
			<p class="max-w-[360px] leading-relaxed text-zinc-400">
				Client sites, commercial Discord bots and open-source tooling. Featured first, the rest one click away.
			</p>
		</div>

		<div class="mt-14 grid gap-4 md:grid-cols-6">
			{featuredProjects.map((project) => <ProjectCard {...project} />)}
		</div>

		<details class="more-projects mt-4 text-center">
			<summary
				class="display-font mt-6 inline-flex cursor-pointer items-center gap-2.5 rounded-full border border-white/50 px-6 py-3 text-[15px] font-semibold transition hover:-translate-y-0.5 hover:bg-white/10"
			>
				Show {moreProjects.length} more projects
			</summary>
			<div class="grid gap-4 text-left md:grid-cols-6">
				{moreProjects.map((project) => <ProjectCard {...project} />)}
			</div>
		</details>
	</div>
</section>

<style>
	.projects::before {
		content: "";
		position: absolute;
		left: -300px;
		bottom: -350px;
		width: 700px;
		height: 700px;
		background: radial-gradient(circle, rgba(174, 172, 255, 0.35), transparent 65%);
		filter: blur(30px);
		pointer-events: none;
	}

	.more-projects summary {
		list-style: none;
	}

	.more-projects summary::-webkit-details-marker {
		display: none;
	}

	.more-projects[open] summary {
		display: none;
	}
</style>
