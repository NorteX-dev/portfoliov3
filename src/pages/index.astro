---
import "../styles/global.css";
import Nav from "../components/astro/Nav.astro";
import Hero from "../components/astro/Hero.astro";
import ScrollDownButton from "../components/astro/ScrollDownButton.astro";
import TechnologiesSlider from "../components/astro/TechnologiesSlider.astro";
import About from "../components/astro/About.astro";
import Projects from "../components/astro/Projects.astro";
import Contact from "../components/astro/Contact.astro";
import Footer from "../components/astro/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta property="title" content="NorteX" />
		<meta property="description" content="Beautiful websites coded with love." />
		<meta property="og:title" content="NorteX" />
		<meta property="og:description" content="Beautiful websites coded with love." />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="theme-color" content="#0765ff" />
		<meta property="twitter:card" content="summary_large_image" />
		<title>NorteX</title>
	</head>
	<body>
		<Nav />
		<Hero />
		<ScrollDownButton />
		<TechnologiesSlider />
		<About class="mt-48" />
		<Projects class="mt-48" />
		<Contact class="mt-16" />
		<Footer class="mt-16" />
	</body>
</html>

<style is:global>
	@reference "tailwindcss";

	body {
		font-family: "Space Grotesk", sans-serif;
		overflow-x: hidden;
	}

	* {
		box-sizing: border-box;
		scroll-behavior: smooth;
	}

	.display-font {
		font-family: "Space Grotesk", sans-serif;
	}

	.inter {
		font-family: "Inter", sans-serif;
	}

	.container {
		@apply mx-auto px-4 max-w-3xl;
	}

	.container-wide {
		@apply mx-auto px-4 max-w-5xl;
	}
</style>

<script is:inline>
	const ctcComponents = document.querySelectorAll("[data-ctc]");
	ctcComponents.forEach((component) => {
		component.addEventListener("click", () => {
			let originalText = component.innerHTML;
			component.innerHTML = "Copied to clipboard!";
			navigator.clipboard.writeText(component.getAttribute("data-ctc"));
			setTimeout(() => {
				component.innerHTML = originalText;
			}, 2000);
		});
	});
</script>
