---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import Hero from "../components/astro/Hero.astro";
import TechnologiesSlider from "../components/astro/TechnologiesSlider.astro";
import About from "../components/astro/About.astro";
import Projects from "../components/astro/Projects.astro";
import Contact from "../components/astro/Contact.astro";
import Footer from "../components/astro/Footer.astro";
import { getTranslations, locales, toLocale } from "@/i18n/translations";

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const alternates = locales.map((alternate) => ({
	locale: alternate,
	href: new URL(getRelativeLocaleUrl(alternate), Astro.url).href,
}));
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={t.meta.description} />
		<meta property="og:title" content="NorteX" />
		<meta property="og:description" content={t.meta.description} />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="theme-color" content="#0765ff" />
		<meta name="twitter:card" content="summary_large_image" />
		{alternates.map(({ locale: hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates[0].href} />
		<title>NorteX</title>
	</head>
	<body data-copied-label={t.copied}>
		<Hero />
		<TechnologiesSlider />
		<About />
		<Projects />
		<Contact />
		<Footer />
	</body>
</html>

<style is:global>
	@reference "tailwindcss";

	body {
		font-family: "Space Grotesk", sans-serif;
		overflow-x: hidden;
	}

	* {
		box-sizing: border-box;
		scroll-behavior: smooth;
	}

	.display-font {
		font-family: "Space Grotesk", sans-serif;
	}

	.inter {
		font-family: "Inter", sans-serif;
	}

	.container {
		@apply mx-auto px-4 max-w-3xl;
	}

	.container-wide {
		@apply mx-auto px-4 max-w-5xl;
	}
</style>

<script is:inline>
	const ctcComponents = document.querySelectorAll("[data-ctc]");
	ctcComponents.forEach((component) => {
		component.addEventListener("click", () => {
			let originalText = component.innerHTML;
			component.innerHTML = document.body.dataset.copiedLabel;
			navigator.clipboard.writeText(component.getAttribute("data-ctc"));
			setTimeout(() => {
				component.innerHTML = originalText;
			}, 2000);
		});
	});
</script>
